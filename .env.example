APP_NAME=AgentHub
APP_VERSION=0.2.0
ENVIRONMENT=development
DEBUG=false
API_V1_PREFIX=/api/v1
LOG_LEVEL=INFO
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

DATABASE_URL=postgresql+asyncpg://agenthub:agenthub@localhost:55432/agenthub
REDIS_URL=redis://localhost:6379/0
QDRANT_URL=http://localhost:6333
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=agenthub
MINIO_SECRET_KEY=agenthub-secret
MINIO_SECURE=false
MINIO_BUCKET=agenthub
HEALTH_TIMEOUT_SECONDS=3.0
INTEGRATION_TIMEOUT_SECONDS=3.0
JWT_SECRET_KEY=development-only-change-this-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
MAX_DOCUMENT_SIZE_BYTES=10485760

POSTGRES_DB=agenthub
POSTGRES_USER=agenthub
POSTGRES_PASSWORD=agenthub
MINIO_ROOT_USER=agenthub
MINIO_ROOT_PASSWORD=agenthub-secret
