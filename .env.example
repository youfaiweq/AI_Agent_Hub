APP_NAME=AgentHub
APP_VERSION=0.2.0
ENVIRONMENT=development
DEBUG=false
API_V1_PREFIX=/api/v1
LOG_LEVEL=INFO
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

DATABASE_URL=postgresql+asyncpg://agenthub:agenthub@localhost:55432/agenthub
REDIS_URL=redis://localhost:6379/0
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION_PREFIX=agenthub_kb
EMBEDDING_PROVIDER=hash
EMBEDDING_MODEL_NAME=hash-v1
EMBEDDING_DIMENSION=384
RETRIEVAL_SCORE_THRESHOLD=0.2
LLM_PROVIDER=openai_compatible
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=30.0
LLM_TEMPERATURE=0.2
RERANKER_PROVIDER=cohere
RERANKER_BASE_URL=https://api.cohere.com/v2
RERANKER_API_KEY=
RERANKER_MODEL_NAME=rerank-v3.5
RERANKER_TIMEOUT_SECONDS=10.0
RERANKER_FALLBACK_ENABLED=false
RERANKER_TOP_K=5
AGENT_MAX_STEPS=10
AGENT_TIMEOUT_SECONDS=30.0
AGENT_ROUTER_MODEL=qwen-flash
AGENT_HISTORY_MAX_MESSAGES=8
AGENT_TOOL_RESULTS_MAX=4
TOOL_TIMEOUT_SECONDS=30.0
CHAT_HISTORY_MAX_MESSAGES=8
CHAT_CONTEXT_TOKEN_BUDGET=2000
CHAT_RETRIEVAL_TOP_K=5
SQL_ALLOWED_TABLES=[]
SQL_TIMEOUT_SECONDS=5.0
SQL_ROW_LIMIT=100
WEB_SEARCH_PROVIDER=tavily
WEB_SEARCH_BASE_URL=https://api.tavily.com
WEB_SEARCH_API_KEY=
WEB_SEARCH_TIMEOUT_SECONDS=10.0
WEB_SEARCH_MAX_RESULTS=5
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=agenthub
MINIO_SECRET_KEY=agenthub-secret
MINIO_SECURE=false
MINIO_BUCKET=agenthub
HEALTH_TIMEOUT_SECONDS=3.0
INTEGRATION_TIMEOUT_SECONDS=3.0
JWT_SECRET_KEY=development-only-change-this-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
MAX_DOCUMENT_SIZE_BYTES=10485760

POSTGRES_DB=agenthub
POSTGRES_USER=agenthub
POSTGRES_PASSWORD=agenthub
MINIO_ROOT_USER=agenthub
MINIO_ROOT_PASSWORD=agenthub-secret
